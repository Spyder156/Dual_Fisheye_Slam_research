+////////////////////////////////////////////////////////////////////////////////
+// MeiCameraModel
+//
+// Derivatives are obtained with Ceres Jets rather than hand-derived closed
+// forms. For a 9-parameter model that is far less error-prone, and the result
+// is exact (autodiff, not finite differences). Layout matches the convention
+// verified by models_jacobian_test.cc: row-major, params block then uvw block.
+
+template <bool Enable, typename std::enable_if<Enable, int>::type>
+bool MeiCameraModel::ImgFromCamWithJac(const double* params,
+                                       const double& u,
+                                       const double& v,
+                                       const double& w,
+                                       double* x,
+                                       double* y,
+                                       double* J_params,
+                                       double* J_uvw,
+                                       const bool check_cheirality) {
+  constexpr int kNumParams = static_cast<int>(num_params);
+  constexpr int kNumDerivs = kNumParams + 3;
+  using JetT = ceres::Jet<double, kNumDerivs>;
+
+  JetT params_jet[kNumParams];
+  for (int i = 0; i < kNumParams; ++i) {
+    params_jet[i] = JetT(params[i], i);
+  }
+  JetT u_jet(u, kNumParams);
+  JetT v_jet(v, kNumParams + 1);
+  JetT w_jet(w, kNumParams + 2);
+
+  JetT x_jet, y_jet;
+  if (!ImgFromCam(params_jet, u_jet, v_jet, w_jet, &x_jet, &y_jet,
+                  check_cheirality)) {
+    return false;
+  }
+
+  *x = x_jet.a;
+  *y = y_jet.a;
+  if (J_params != nullptr) {
+    for (int i = 0; i < kNumParams; ++i) {
+      J_params[i] = x_jet.v[i];
+      J_params[kNumParams + i] = y_jet.v[i];
+    }
+  }
+  if (J_uvw != nullptr) {
+    for (int i = 0; i < 3; ++i) {
+      J_uvw[i] = x_jet.v[kNumParams + i];
+      J_uvw[3 + i] = y_jet.v[kNumParams + i];
+    }
+  }
+  return true;
+}
