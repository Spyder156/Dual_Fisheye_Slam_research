+namespace {
+/// \brief Apply an optional validity mask to a camera geometry.
+/// OpenCV/OKVIS convention: 0 == masked (invalid), nonzero == valid. This is
+/// the INVERSE of OpenVINS, where nonzero means "ignore" -- convert when
+/// sharing a mask file between the two.
+template<typename CamT>
+void applyMask(std::shared_ptr<CamT>& cam, const okvis::CameraCalibration& calib,
+               size_t camIdx) {
+  if (calib.imageMask.empty()) {
+    return;
+  }
+  cv::Mat m = cv::imread(calib.imageMask, cv::IMREAD_GRAYSCALE);
+  if (m.empty()) {
+    LOG(FATAL) << "camera " << camIdx << ": could not read image_mask "
+               << calib.imageMask;
+  }
+  if (m.cols != int(cam->imageWidth()) || m.rows != int(cam->imageHeight())) {
+    cv::resize(m, m, cv::Size(int(cam->imageWidth()), int(cam->imageHeight())),
+               0, 0, cv::INTER_NEAREST);
+  }
+  OKVIS_ASSERT_TRUE(std::runtime_error, cam->setMask(m),
+                    "camera " << camIdx << ": setMask failed")
+  LOG(INFO) << "camera " << camIdx << ": mask " << calib.imageMask << " -- "
+            << cv::countNonZero(m) << "/" << (m.rows * m.cols) << " px valid";
+}
+}  // namespace
